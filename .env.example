# Copy this file to ".env" and fill in your real values. NEVER commit the real .env
# (it is already listed in .gitignore). These are read by src/snowflake_loader.py.
#
# TxDOT uses Microsoft SSO, so there is NO password here -- config.yaml has
# authenticator: externalbrowser, which opens a browser for you to log in.

SNOWFLAKE_ACCOUNT=txdot-dm_bal_c.privatelink
SNOWFLAKE_USER=your_txdot_login          # usually your TxDOT email, e.g. steven.ma@txdot.gov
